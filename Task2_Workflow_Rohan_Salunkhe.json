      "id": "42da9dc0-c9ca-4721-9ccb-300a3666ad7f",
      "name": "IF - Title Longer Than 50 Characters",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1184,
        128
      ]
    },
    {
      "parameters": {
        "jsCode": "const posts = $input.all().map((item) => item.json);\nconst digest = posts.map((post, index) => {\n  const author = post.author || {};\n  return `${index + 1}. ${post.title}\\nPost ID: ${post.id}\\nAuthor: ${author.name || 'Unknown'}\\nAuthor email: ${author.email || 'Not available'}\\n\\n${post.body}`;\n}).join('\\n\\n----------------------------------------\\n\\n');\n\nreturn [{ json: { subject: `Morning Brief - Long Titles (${posts.length})`, digest, itemCount: posts.length } }];"
      },

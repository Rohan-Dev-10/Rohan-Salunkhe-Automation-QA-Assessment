        "jsCode": "const errors = $input.all().map((item) => {\n  const data = item.json || {};\n  const detail = data.error?.message || data.error || data.message || data;\n  return typeof detail === 'string' ? detail : JSON.stringify(detail);\n});\n\nreturn [{\n  json: {\n    subject: 'ALERT: Morning Brief API request failed',\n    digest: `The Daily API Morning Brief workflow could not complete an API request.\\n\\nError details:\\n${errors.join('\\n\\n')}\\n\\nPlease open the n8n execution to inspect the failed request.`\n  }\n}];"

    {
      "parameters": {
        "jsCode": "// Keep the first five valid posts, sorted by post ID.\nconst posts = $input.all().map((item) => item.json);\n\nconst topFive = posts\n  .filter((post) => post && post.id !== undefined && post.userId !== undefined && post.title && post.body)\n  .sort((a, b) => Number(a.id) - Number(b.id))\n  .slice(0, 5);\n\nreturn topFive.map((post) => ({ json: post }));"
      },
      "id": "1ba62997-54c2-4908-8865-9b60cbd4a7fc",
      "name": "Select Top 5 Posts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        464,
        128
      ]
    },
    {
      "parameters": {
        "url": "=https://jsonplaceholder.typicode.com/users/{{$json.userId}}",
        "options": {}
      },
      "id": "fd650037-42a9-45f4-b5b1-c2bfe78c23a2",
      "name": "Get Author Details",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        704,
        128
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// Join each post to the user returned by the second API call.\nconst posts = $('Select Top 5 Posts').all().map((item) => item.json);\nconst authors = $input.all().map((item) => item.json);\nconst authorById = new Map(authors.map((author) => [Number(author.id), author]));\n\nreturn posts.map((post) => {\n  const author = authorById.get(Number(post.userId)) || null;\n  return {\n    json: {\n      ...post,\n      author: author ? { name: author.name, username: author.username, email: author.email } : null\n    }\n  };\n});"
      },
      "id": "c6e11a0e-c054-43b8-a3d1-83f6acd452bc",
      "name": "Combine Posts and Authors",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        944,
        128
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "b6c8e5b1-9f14-4f17-9b01-000000000201",
              "leftValue": "={{ $json.title.length }}",
              "rightValue": 50,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
